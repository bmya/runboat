resources:
  {%- if mode == 'deployment' %}
  - pvc.yaml
  - deployment.yaml
  - service.yaml
  - ingress_odoo.yaml
  - ingress_mailhog.yaml
  {%- if isolated %}
  - basicauth.yaml
  {%- endif %}
  {%- elif mode == "initialize" %}
  - pvc.yaml
  - fetch.yaml
  - initialize.yaml
  {%- elif mode == "cleanup" %}
  - cleanup.yaml
  {%- elif mode == "test" %}
  - pvc.yaml
  - test.yaml
  {%- endif %}
  {%- if isolated %}
  - networkpolicy.yaml
  {%- endif %}

namespace: {{ namespace }}

namePrefix: "{{ build_name }}-"

labels:
  - pairs:
      runboat/build: "{{ build_name }}"
    includeSelectors: true
    includeTemplates: true

commonAnnotations:
  runboat/repo: "{{ commit_info.repo }}"
  runboat/target-branch: "{{ commit_info.target_branch }}"
  runboat/pr: "{{ commit_info.pr if commit_info.pr else '' }}"
  runboat/git-commit: "{{ commit_info.git_commit }}"

images:
  - name: odoo
    newName: "{{ image_name }}"
    newTag: "{{ image_tag }}"
  - name: mailhog
    newName: "mailhog/mailhog"
    newTag: "latest"

secretGenerator:
  - name: odoosecretenv
    literals:
      {%- for key, value in build_secret_env.items() %}
      - {{ key }}={{ value }}
      {%- endfor %}
  {%- if mode == "initialize" %}
  - name: fetchsecretenv
    literals:
      - RUNBOAT_FETCH=1
      {%- for key, value in build_fetch_secret_env.items() %}
      - {{ key }}={{ value }}
      {%- endfor %}
  {%- endif %}
  {%- if mode == "deployment" and isolated %}
  - name: basicauth
    literals:
      - users={{ basic_auth_users }}
  {%- endif %}

configMapGenerator:
  - name: odooenv
    literals:
      - PGDATABASE={{ build_name }}
      - ADDONS_DIR=/mnt/data/odoo-addons-dir
      - RUNBOAT_GIT_REPO={{ commit_info.repo }}
      - RUNBOAT_GIT_REF={{ commit_info.git_commit }}
      - RUNBOAT_GIT_TARGET_BRANCH={{ commit_info.target_branch }}
      - RUNBOAT_ISOLATED={{ "1" if isolated else "0" }}
      {%- for key, value in build_env.items() %}
      - {{ key }}={{ value }}
      {%- endfor %}
      {%- if test_modules %}
      - TEST_MODULES={{ test_modules }}
      {%- endif %}
  {%- if mode == "initialize" %}
  - name: initnonce
    literals:
      - RUNBOAT_INIT_NONCE={{ init_nonce }}
  {%- endif %}
  - name: runboat-scripts
    files:
      - runboat-fetch.sh
      - runboat-clone-and-install.sh
      - runboat-initialize.sh
      - runboat-cleanup.sh
      - runboat-start.sh
      - runboat-test.sh

generatorOptions:
  disableNameSuffixHash: true

patches:
  - target:
      kind: PersistentVolumeClaim
      name: data
    patch: |-
      - op: replace
        path: /spec/storageClassName
        value: {{ build_template_vars["storageClassName"] }}
  - target:
      kind: Ingress
      name: odoo
    patch: |-
      - op: replace
        path: /spec/rules/0/host
        value: {{ build_slug }}.{{ build_domain }}
  - target:
      kind: Ingress
      name: mailhog
    patch: |-
      - op: replace
        path: /spec/rules/0/host
        value: {{ build_slug }}.mail.{{ build_domain }}
  {%- if isolated %}
  {%- for ingress in ("odoo", "mailhog") %}
  - target:
      kind: Ingress
      name: {{ ingress }}
    patch: |-
      - op: add
        path: /metadata/annotations/traefik.ingress.kubernetes.io~1router.middlewares
        value: {{ namespace }}-{{ build_name }}-basicauth@kubernetescrd
  {%- endfor %}
  {%- endif %}
